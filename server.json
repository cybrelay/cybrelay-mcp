{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.cybrelay/mcp",
  "title": "CybRelay",
  "description": "Vulnerability remediation for AI agents: deterministic fix scripts, AI advice only, web scan.",
  "version": "1.1.0",
  "websiteUrl": "https://cybrelay.com",
  "repository": { "url": "https://github.com/cybrelay/cybrelay-mcp", "source": "github" },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.cybrelay.com/mcp",
      "headers": [
        { "name": "Authorization", "description": "Bearer <CybRelay workspace API key> (free account at cybrelay.com)", "isRequired": true, "isSecret": true }
      ]
    },
    {
      "type": "sse",
      "url": "https://api.cybrelay.com/sse",
      "headers": [
        { "name": "Authorization", "description": "Bearer <CybRelay workspace API key>", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
